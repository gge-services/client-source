{
  "name": "@gge/client-canonical",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compare": "node compare.mjs",
    "test": "node --test test.mjs fetch-client.test.mjs refine-modules.test.mjs semantic-view.test.mjs reverse-ts-es5.test.mjs resolve-imports.test.mjs resolve-graph-identities.test.mjs compare-official-raw.test.mjs semantic-parameters.test.mjs event-identities.test.mjs literal-identities.test.mjs audit-command-abi.test.mjs compare-raw-revisions.test.mjs reconstruct-dependencies.test.mjs cross-bundle-aliases.test.mjs audit-neighborhoods.test.mjs",
    "verify": "node verify.mjs ../..",
    "audit": "node audit-symbol-views.mjs ../..",
    "reconstruct": "npm run graph && node reconstruct-commands.mjs ../.. && node reconstruct-dependencies.mjs ../..",
    "graph": "node build-semantic-graph.mjs ../.. ../../graphs/2026-10-16.jsonl && node audit-dll-edges.mjs ../.. ../../graphs/2026-10-16-dll-edges.jsonl && node resolve-graph-identities.mjs ../.. ../../graphs/2026-10-16-derived-identities.jsonl",
    "typecheck:compat": "node audit-ts-project.mjs ../.. /tmp/gge-client-ts-typecheck --emit",
    "typecheck:complete": "node audit-ts-project.mjs ../.. /tmp/gge-client-ts-typecheck-complete --emit --strict",
    "audit:all-classes": "node audit-all-classes.mjs ../.. /tmp/gge-all-class-audit.json",
    "compare:official": "node compare-official-raw.mjs ../.. /tmp/gge-official-20261025-live /tmp/gge-official-raw-compare.json",
    "parameter-audit": "node audit-parameter-roles.mjs ../.. ../../graphs/2026-10-16-parameter-roles.json",
    "parameter-audit:check": "node audit-parameter-roles.mjs ../.. ../../graphs/2026-10-16-parameter-roles.json --check",
    "events:compare": "node event-identities.mjs ../.. /tmp/gge-official-20261025-live ../../graphs/2026-10-25-event-identities.jsonl",
    "literals:compare": "node literal-identities.mjs ../.. /tmp/gge-official-20261025-live ../../graphs/2026-10-25-literal-identities.jsonl",
    "abi:compare": "node audit-command-abi.mjs ../.. /tmp/gge-official-20261025-live ../../graphs/2026-10-25-command-abi.jsonl",
    "raw:diff": "node compare-raw-revisions.mjs /tmp/gge-official-20261025-live /tmp/gge-official-20261027-rawdiff ../../graphs/2026-10-25-to-2026-10-27-rawdiff.json",
    "dependencies:reconstruct": "node reconstruct-dependencies.mjs ../..",
    "neighborhoods:compare": "node audit-neighborhoods.mjs ../.. /tmp/gge-official-20261025-live /tmp/gge-official-20261027-rawdiff ../../graphs/2026-10-25-to-2026-10-27-neighborhoods.jsonl"
  },
  "dependencies": {
    "@babel/generator": "7.29.0",
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.0"
  },
  "devDependencies": {
    "typescript": "2.9.2"
  }
}
